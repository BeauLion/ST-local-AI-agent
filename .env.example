# Copy this file to ".env" (same folder, next to config.py) and fill in
# your real values. ".env" is already in .gitignore - it will never be
# committed, but double check with `git status` if you're ever unsure.
# docker-compose.yml passes it to the container via env_file.

# Your Apple ID email address (the one your iCloud calendar is on).
CALDAV_USERNAME=

# NOT your real Apple ID password. Generate this at:
#   appleid.apple.com -> Sign-In and Security -> App-Specific Passwords -> Generate
CALDAV_PASSWORD=

# Comma-separated list of extra origins allowed to call the agent server's
# HTTP API (Tailscale IPs, LAN IPs, etc.). localhost is always allowed.
EXTRA_CORS_ORIGINS=

# Key SillyTavern sends to the agent. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# ── Model backend ──────────────────────────────────────────────
# "local" = the agent launches llama-server itself (Windows run.bat setup).
# "llama-swap" = the model runs on another machine behind llama-swap
# (the Docker image defaults to this).
#LLAMA_BACKEND=llama-swap

# Where llama-server / llama-swap is reachable, e.g. over Tailscale.
LLAMA_SERVER_URL=http://100.x.x.x:8080

# Key the agent sends to llama-server/llama-swap. Defaults to AGENT_API_KEY
# if unset; better to use a separate one once the model runs remotely.
LLAMA_API_KEY=

# llama-swap model name to use on first boot and for "Reset" (a key under
# `models:` in llama-swap's config.yaml). Empty = first model listed.
LLAMA_SWAP_DEFAULT_MODEL=

# ── iCloud bridge (optional, see config.BRIDGE_ENABLED) ────────
BRIDGE_URL=
BRIDGE_TOKEN=
